# GEMINI_API_KEY: Server-only key for the AI proxy (/api/ai). This is the
# ONLY place the Gemini key should live in production — never expose it with a
# VITE_ prefix, or it ships inside the browser bundle where anyone can read it
# and bill your account. The server proxy verifies the user's Supabase session
# and `entitlements.ai_access` before calling Gemini.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional server-side allow-list (comma-separated emails) that always get AI
# access regardless of the entitlements table. Resolved server-side so it
# cannot be spoofed from the browser.
AI_ALLOW_EMAILS=""

# Supabase public client values (safe to expose — these are the browser keys).
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
VITE_AUTH_REDIRECT_URL="https://resume-builder-softbranes-projects.vercel.app"

# Optional: comma-separated emails shown the AI UI as "enabled" in the browser.
# This is UX-only — the server (/api/ai) is the real gate. Keep it in sync with
# AI_ALLOW_EMAILS if you use it.
VITE_AI_ALLOW_EMAILS=""

# Server-only Vercel Function values for analytics, share storage, password
# account creation, and the AI proxy. Never expose these with a VITE_ prefix.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GEMINI_API_KEY: Optional. Enables Gemini AI import, ATS tailoring,
# and richer writing suggestions. Gemini has a free tier for API keys.
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_API_KEY is also supported for AI Studio-style environments.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Supabase public client values.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
VITE_AUTH_REDIRECT_URL="https://resume-builder-softbranes-projects.vercel.app"

# Server-only Vercel Function values for analytics and share storage.
# Never expose this with a VITE_ prefix.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
